# Copy to .env and adjust. All values are optional — these are the defaults.

# LLM for SPARQL generation — any OpenAI-compatible endpoint (called via the openai SDK).
#   LLM_BASE_URL  — endpoint base URL, include /v1. Ollama serves one at http://localhost:11434/v1;
#                   for hosted OpenAI use https://api.openai.com/v1.
#   LLM_API_KEY   — bearer token; only needed for hosted endpoints (Ollama ignores it).
LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# gemma4:31b — instruct model (~19 GB) that answers every question type in the eval suite
# (class hierarchy, transitive paths, taxonomy, schema grounding). A ~30B model is the sweet
# spot here; smaller models score lower on property paths. The prompt + grounding are
# model-agnostic — re-run `text2sparql eval` after a swap to measure the change.
LLM_MODEL=gemma4:31b

# Self-repair: total generation attempts. If a query raises a SPARQL error, the error is fed back
# to the model to fix (a valid query returning 0 rows is left as-is). 1 disables repair.
TEXT2SPARQL_MAX_ATTEMPTS=2

# Storage for the graph registry (cached ontology + prefixes).
TEXT2SPARQL_DATA_DIR=.text2sparql

# Request timeout (seconds) for the LLM call.
TEXT2SPARQL_TIMEOUT=180
