# Copy to .env and adjust. All values are optional — these are the defaults.

# Self-hosted LLM (Ollama). Point this anywhere Ollama runs.
OLLAMA_BASE_URL=http://localhost:11434
# gemma4:31b — instruct model (~19 GB) that answers every question type in the eval suite
# (class hierarchy, transitive paths, taxonomy, schema grounding). A ~30B model is the sweet
# spot here; a 4 B model (e.g. qwen3.5:4b) scores far lower on property paths. The prompt +
# grounding are model-agnostic — re-run `text2sparql eval` after a swap to measure the change.
TEXT2SPARQL_GEN_MODEL=gemma4:31b

# For hybrid reasoning models (e.g. qwen3.5) we disable chain-of-thought by default for speed —
# the grounding in the prompt does the heavy lifting. gemma4 isn't a reasoning model, so this is a
# no-op for it; the parser strips any <think> block regardless. Set to 1 to re-enable thinking.
TEXT2SPARQL_THINK=0

# Self-repair: total generation attempts. If a query raises a SPARQL error, the error is fed back
# to the model to fix (a valid query returning 0 rows is left as-is). 1 disables repair.
TEXT2SPARQL_MAX_ATTEMPTS=2

# Introspection limits (keep ingest cheap on large graphs / endpoints).
TEXT2SPARQL_MAX_CLASSES=200
TEXT2SPARQL_SAMPLE_LIMIT=2000

# Storage for the graph registry (cached ontology + prefixes).
TEXT2SPARQL_DATA_DIR=.text2sparql

# Execution. Default REJECTS SPARQL Update (INSERT/DELETE/...). Set to 1 to allow them.
TEXT2SPARQL_ALLOW_UPDATE=0
TEXT2SPARQL_MAX_ROWS=500
TEXT2SPARQL_TIMEOUT=180
