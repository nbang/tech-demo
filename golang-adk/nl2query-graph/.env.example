# Copy to .env and edit. Real environment variables override these.

# --- LLM (OpenAI-compatible endpoint) ---
# Your NVIDIA key (or any OpenAI-compatible key).
OPENAI_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx
# API root, WITHOUT the /chat/completions suffix.
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# Model id as served by your endpoint.
OPENAI_MODEL=nvidia/gemma4:31b

# --- Query targets ---
# SQL branch: SQLite file (auto-created + seeded with sample data if missing).
SQLITE_PATH=./examples/shop.db
# SPARQL branch: Turtle file (a sample kg.ttl ships in ./examples).
TTL_PATH=./examples/kg.ttl
