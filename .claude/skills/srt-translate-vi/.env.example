# Copy to .env (gitignored) and fill in. Real environment variables win over this file.

# NVIDIA build.nvidia.com : https://integrate.api.nvidia.com/v1
SRT_API_KEY=nvapi-...

# Optional. Defaults target NVIDIA's hosted deepseek-ai/deepseek-v4-flash.
# SRT_API_BASE=https://integrate.api.nvidia.com/v1
# SRT_MODEL=deepseek-ai/deepseek-v4-flash
