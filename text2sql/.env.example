# Copy to .env and adjust. All values are optional — these are the defaults.

# Self-hosted LLM (Ollama). Point this anywhere OpenAI-compatible-ish Ollama runs.
OLLAMA_BASE_URL=http://localhost:11434
TEXT2SQL_GEN_MODEL=qwen3.5:4b
TEXT2SQL_EMBED_MODEL=nomic-embed-text

# RAG
TEXT2SQL_TOP_K=8

# Storage for the schema index + database registry.
TEXT2SQL_DATA_DIR=.text2sql

# Execution. Default is full execution (writes allowed). Set to 1 to force READ ONLY.
TEXT2SQL_READONLY=0
TEXT2SQL_MAX_ROWS=500
TEXT2SQL_TIMEOUT=180
